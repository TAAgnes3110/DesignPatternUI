<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Design Patterns"
            android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
            android:textColor="@color/material_dynamic_primary10"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:text="Các mẫu thiết kế trong ứng dụng quản lý bệnh viện"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:alpha="0.7" />

        <!-- Builder Pattern Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/material_dynamic_primary10"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#E3F2FD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Builder Pattern"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textColor="@color/material_dynamic_primary10"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Quản lý khởi tạo đối tượng Bệnh Nhân (Patient) phức tạp. Tách biệt quá trình xây dựng object khỏi biểu diễn của nó."
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:lineSpacingMultiplier="1.2"
                    android:alpha="0.8" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCommandPattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Xem Demo Builder"
                    app:backgroundTint="@color/material_dynamic_primary10"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Facade Pattern Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/material_dynamic_primary10"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#F3E5F5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Facade Pattern"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="#7B1FA2"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Cung cấp giao diện đơn giản cho hệ thống phức tạp. Ẩn đi sự phối hợp giữa Appointments, Records và Billing."
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:lineSpacingMultiplier="1.2"
                    android:alpha="0.8" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSingletonPattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Xem Demo Facade"
                    app:backgroundTint="#7B1FA2"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
