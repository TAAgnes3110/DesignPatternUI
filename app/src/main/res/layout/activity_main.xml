<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Kết Thúc Học Phần"
            android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
            android:textColor="@color/material_dynamic_primary10"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="48dp"
            android:text="Demo 2 Form Nhập Dữ Liệu"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:gravity="center"
            android:alpha="0.7" />

        <!-- Form 1 Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonForm1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Form 1: Nhập 1 Bảng"
            android:textSize="18sp"
            android:padding="16dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/material_dynamic_primary10" />

        <!-- Form 2 Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonForm2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Form 2: Nhập Nhiều Bảng"
            android:textSize="18sp"
            android:padding="16dp"
            app:cornerRadius="12dp"
            app:backgroundTint="#7B1FA2" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
